# Copy this file to .env and fill in your values

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/plagiarism_db

# ── Google Custom Search API ─────────────────────────────────────────────────
# Get your key at: https://console.developers.google.com/
# Create a Custom Search Engine at: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
