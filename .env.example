# =================================================================
# Backend Environment Configuration Template
# Copy this file to .env and fill in your actual production values.
# =================================================================

# ── MongoDB Connection ───────────────────────────────────────────
# For local development: mongodb://localhost:27017
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/plagiarism_db?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017

# ── Security & Authentication ─────────────────────────────────────
# Generate a strong 32-byte hex secret key using: openssl rand -hex 32
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# ── CORS Settings ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# ── Optional: Google Custom Search for Live Web Plagiarism ───────
# Leave blank to rely on internal repository plagiarism detection only
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
